---
import { getContent, type Lang } from "../i18n";

interface Props { lang?: Lang }
const { lang = "en" } = Astro.props;
const { homeNavItems, whatWeDoNavItems } = getContent(lang);

const path = Astro.url.pathname.replace(/\/$/, "");
const isWhatWeDo = path === "/what-we-do" || path === "/id/what-we-do";
const navItems = isWhatWeDo ? whatWeDoNavItems : homeNavItems;
// Mobile overlay items: same per-route list minus the hero/top entry.
const mobileItems = (isWhatWeDo ? whatWeDoNavItems : homeNavItems)
  .filter((i) => i.id !== "hero")
  .map((i) => ({ ...i }));
// Contact is pulled out as a distinct CTA button; the rest become a numbered list.
const contactItem = mobileItems.find((i) => i.id === "contact");
const mobileMain = mobileItems.filter((i) => i.id !== "contact");
---

<!-- Desktop dot nav — color adapts to the active section (light/dark) via scroll-spy -->
<nav id="sectionNav" class="fixed right-5 top-1/2 z-50 hidden -translate-y-1/2 text-white transition-colors duration-300 md:block" aria-label="Section navigation">
  <ul class="flex flex-col gap-3.5">
    {navItems.map((item) => (
      <li>
        <a href={`#${item.id}`} data-nav={item.id} class="nav-dot flex items-center justify-end gap-2" aria-label={item.label}>
          <span class="nav-label text-[10px] font-semibold uppercase tracking-wider opacity-0 transition-opacity">
            {item.label}
          </span>
          <span class="nav-bullet block h-2.5 w-2.5 rounded-full border-2 border-current bg-transparent transition-all duration-300"></span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<!-- Mobile hamburger -->
<button id="navToggle" class="fixed right-5 top-5 z-[60] flex h-11 w-11 items-center justify-center text-white md:hidden" style="mix-blend-mode: difference;" aria-label="Open menu" aria-expanded="false">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="menu-bars h-6 w-6"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="menu-x h-6 w-6"><path d="M6 6l12 12M18 6 6 18"/></svg>
</button>

<!-- Mobile overlay menu -->
<div id="navOverlay" class="fixed inset-0 z-[55] hidden flex-col bg-ink/95 backdrop-blur-xl md:hidden">
  <div class="flex items-center gap-2.5 px-6 pt-6">
    <img src="/logo/WOMD_Icon_SpeechBubble_transparent_1500.png" alt="" aria-hidden="true" width="36" height="36" class="h-8 w-8" />
    <span class="font-headline text-sm font-extrabold uppercase tracking-[0.1em] text-brand-yellow">WOMD<span class="text-white">.</span></span>
  </div>
  <nav class="flex flex-1 flex-col overflow-y-auto px-8 py-6" aria-label="Mobile menu">
    <div class="my-auto flex flex-col gap-4">
      {mobileMain.map((item, i) => (
        <a href={`#${item.id}`} class="ov-item group flex items-baseline gap-4" style={`--i:${i}`}>
          <span class="font-headline text-xs font-bold tabular-nums text-brand-yellow/70">{String(i + 1).padStart(2, "0")}</span>
          <span class="font-headline text-2xl font-extrabold uppercase leading-tight tracking-wide text-white transition-colors group-active:text-brand-yellow">{item.label}</span>
        </a>
      ))}
      {contactItem && (
        <a href={`#${contactItem.id}`} class="ov-item mt-5 inline-flex w-fit items-center gap-2 rounded-full bg-brand-yellow px-7 py-3.5 font-headline text-sm font-extrabold uppercase tracking-[0.15em] text-ink" style={`--i:${mobileMain.length}`}>
          {contactItem.label} <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </nav>
</div>

<style is:global>
  /* Bulletproof active state. Explicit white default, ink in is-light. */
  #sectionNav .nav-dot.is-active .nav-bullet {
    background-color: #ffffff !important;
    border-color: #ffffff !important;
  }
  #sectionNav.is-light .nav-dot.is-active .nav-bullet {
    background-color: #2b2b2b !important;
    border-color: #2b2b2b !important;
  }
  #sectionNav .nav-dot.is-active .nav-label { opacity: 1 !important; }
  /* Reveal the section title on hover for any dot (not just the active one). */
  #sectionNav .nav-dot:hover .nav-label { opacity: 1 !important; }
  /* Hero exception: keep the active dot filled, hide the label entirely. */
  #sectionNav .nav-dot.is-active[data-nav="hero"] .nav-label { opacity: 0 !important; }

  /* Mobile overlay menu — staggered entrance per item when the menu opens (.flex). */
  #navOverlay .ov-item { opacity: 0; transform: translateY(10px); }
  #navOverlay.flex .ov-item {
    animation: ovItemIn 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    animation-delay: calc(var(--i, 0) * 45ms + 60ms);
  }
  @keyframes ovItemIn { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    #navOverlay .ov-item { opacity: 1; transform: none; }
    #navOverlay.flex .ov-item { animation: none; }
  }
</style>

<script is:inline>
  (function () {
    const init = () => {
    // Section ids whose background is light (dots should be dark there)
    const LIGHT = new Set(["who", "pillar-01", "pillar-02", "pillar-03", "pillar-04", "pillar-05", "team", "audience"]);

    const nav = document.getElementById("sectionNav");
    const dots = Array.from(document.querySelectorAll(".nav-dot"));
    if (nav && dots.length) {
      const apply = (id) => {
        dots.forEach((d) => d.classList.toggle("is-active", d.getAttribute("data-nav") === id));
        nav.classList.toggle("is-light", LIGHT.has(id));
      };
      const sectionMap = dots
        .map((d) => ({ id: d.getAttribute("data-nav"), el: document.getElementById(d.getAttribute("data-nav")) }))
        .filter((s) => s.el);
      let ticking = false;
      const update = () => {
        ticking = false;
        const vhCenter = window.innerHeight / 2;
        let activeId = null, minDist = Infinity;
        for (const s of sectionMap) {
          const r = s.el.getBoundingClientRect();
          const center = r.top + r.height / 2;
          const d = Math.abs(center - vhCenter);
          if (d < minDist) { minDist = d; activeId = s.id; }
        }
        if (activeId) apply(activeId);
      };
      const onScroll = () => {
        if (!ticking) { requestAnimationFrame(update); ticking = true; }
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    }

    // Mobile hamburger overlay
    const toggle = document.getElementById("navToggle");
    const overlay = document.getElementById("navOverlay");
    if (toggle && overlay) {
      const open = () => {
        overlay.classList.remove("hidden");
        overlay.classList.add("flex");
        toggle.classList.add("is-open");
        toggle.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
      };
      const close = () => {
        overlay.classList.add("hidden");
        overlay.classList.remove("flex");
        toggle.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      };
      toggle.addEventListener("click", () =>
        overlay.classList.contains("hidden") ? open() : close()
      );
      overlay.querySelectorAll("a").forEach((a) => a.addEventListener("click", close));
    }
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
