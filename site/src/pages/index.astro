---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import VideoBg from "../components/VideoBg.astro";
import {
  hero, stats, whoWeAre, belief, pillars, process, differentiators, audience, clients, team, closing,
} from "../data/content";

const V = {
  stripes: "/video/WOMD_bg_yellow-stripes_1080.mp4",
  bubbles: "/video/WOMD_motion_chat-bubbles-yellow-stream_pingpong_1080.mp4",
  heroDoodle: "/video/WOMD_bg_hero-doodle-explosion_loop_720.mp4",
  heroDark: "/video/WOMD_bg_hero-dark_loop_720.mp4",
  cubes: "/video/WOMD_bg_yellow-cube-grid_loop_1080.mp4",
  glassBubbles: "/video/WOMD_bg_chat-bubbles-glass-black_loop_1080.mp4",
  organic: "/video/WOMD_bg_organic-particles_loop_1080.mp4",
  tunnel: "/video/WOMD_bg_neon-tunnel_loop_1080.mp4",
  neonglow: "/video/WOMD_bg_chat-bubbles-glass-neonglow_loop_1080.mp4",
  sphere: "/video/WOMD_bg_green-sphere_loop_1080.mp4",
  office: "/video/WOMD_bg_office-sun_loop_1080.mp4",
};
// Per-product icons — order matches pillars[].products (WOMD icon set)
const productIcons = [
  ["/icons/prod-playbook.svg", "/icons/prod-social.svg", "/icons/prod-leadership.svg"],
  ["/icons/prod-research.svg", "/icons/prod-pmf.svg", "/icons/prod-dashboard.svg"],
  ["/icons/prod-lms.svg", "/icons/prod-ai.svg", "/icons/prod-website.svg"],
  ["/icons/prod-brand.svg", "/icons/prod-visual.svg"],
  ["/icons/prod-org.svg", "/icons/prod-training.svg", "/icons/prod-hiring.svg"],
];
---

<Base>
  <header id="siteHeader" class="fixed inset-x-0 top-0 z-40 transition-all duration-300">
    <div class="flex items-center px-5 py-4 sm:px-8 sm:py-5">
      <a href="#hero" class="flex shrink-0 items-center gap-3" aria-label="WOMD — Home">
        <img src="/logo/WOMD_Icon_SpeechBubble_transparent_1500.png" alt="" aria-hidden="true" width="44" height="44" class="h-9 w-9 sm:h-10 sm:w-10" />
        <span class="flex flex-col leading-none">
          <span class="font-headline text-lg font-extrabold uppercase tracking-[0.06em] sm:text-xl"><span class="header-wordmark">WOMD</span><span class="text-brand-yellow">.</span></span>
          <span class="mt-1 hidden font-headline text-[0.58rem] font-semibold uppercase tracking-[0.22em] opacity-70 sm:block">Strategic Transformation Consultancy</span>
        </span>
      </a>
    </div>
  </header>

  <script is:inline>
    (function () {
      const header = document.getElementById("siteHeader");
      if (!header) return;
      const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 150);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    })();
  </script>

  <style is:global>
    /* At top: transparent header, yellow wordmark for hero-stage brand pop */
    #siteHeader { color: #ffffff; background-color: transparent; border-bottom: 1px solid transparent; backdrop-filter: none; }
    #siteHeader .header-wordmark { color: #FDD82D; }
    /* After scrollY > 150px: solid frosted block, white wordmark */
    #siteHeader.is-scrolled { background-color: rgba(43,43,43,0.85); border-bottom-color: rgba(255,255,255,0.08); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
    #siteHeader.is-scrolled .header-wordmark { color: #ffffff; }
  </style>
  <Nav />

  <!-- 1. HERO -->
  <section id="hero" class="snap relative flex h-screen flex-col items-center justify-center overflow-hidden bg-ink px-6 py-20 text-center text-white md:pb-[14vh]">
    <video
      class="absolute inset-0 h-full w-full object-cover"
      style="filter:grayscale(1)"
      src="/video/WOMD_bg_hero-dark_pingpong_720.mp4"
      poster="/video/WOMD_hero-dark_poster.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    ></video>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-ink/75"></div>
    <div class="reveal relative z-10 mx-auto flex max-w-4xl flex-col items-center">
      <img src="/logo/WOMD_Wordmark_transparent_1500.png" alt="WOMD — Weapons of Mass Discussion" width="760" height="232" class="mx-auto block w-[84vw] max-w-3xl drop-shadow-[0_6px_28px_rgba(0,0,0,0.4)]" />
      <p class="mt-7 font-headline text-eyebrow font-bold uppercase tracking-[0.08em] text-white/80">{hero.tagline}</p>
      <p class="mt-7 max-w-5xl font-headline text-[clamp(1.5rem,1rem+1.6vw,2.4rem)] font-extrabold leading-[1.12] tracking-[-0.01em] text-white">
        {hero.subheadPre} <span class="box-decoration-clone bg-brand-yellow px-2 text-ink">{hero.subheadAccent}</span>
      </p>
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-20 bg-cover opacity-[0.05] mix-blend-multiply" style="background-image:url('/textures/grain.jpg')"></div>
  </section>

  <!-- 2. WHO WE ARE -->
  <section id="who" class="snap relative flex min-h-screen items-center overflow-hidden px-6 py-24 text-ink sm:px-12 lg:px-20">
    <img src="/images/WOMD_yellow-slide-bg.jpg" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
    <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(ellipse 70% 70% at 50% 50%, rgba(253,216,45,0) 0%, rgba(253,216,45,0.1) 35%, rgba(253,216,45,0.5) 70%, rgba(253,216,45,0.95) 100%)"></div>
    <div class="relative z-10 mx-auto w-full max-w-6xl">
      <p class="reveal font-headline text-[clamp(0.95rem,0.8rem+0.5vw,1.2rem)] font-bold uppercase tracking-[0.28em] text-ink/60">{whoWeAre.kicker}</p>
      <h2 class="reveal mt-7 font-headline text-[clamp(1.7rem,0.5rem+6vw,5.5rem)] font-extrabold leading-[1.25] tracking-[-0.01em]" style="--reveal-delay:80ms">
        {whoWeAre.headlineLead} <span class="box-decoration-clone bg-ink px-2 text-brand-yellow">{whoWeAre.headlineAccent}</span>
      </h2>
      <div class="reveal mt-12 max-w-4xl space-y-7 text-[clamp(1.15rem,1rem+0.7vw,1.6rem)] font-medium leading-relaxed text-ink/80" style="--reveal-delay:160ms">
        {whoWeAre.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- CORE BELIEF -->
  <section id="belief" class="snap relative flex min-h-screen items-center overflow-hidden px-6 py-24 text-white sm:px-12 lg:px-20">
    <VideoBg src={V.glassBubbles} scrim={52} bg="bg-ink" />
    <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(ellipse 85% 78% at 50% 48%, transparent 22%, rgba(0,0,0,0.5) 60%, rgba(0,0,0,0.92) 100%)"></div>
    <div class="relative z-10 mx-auto w-full max-w-6xl">
      <p class="reveal font-headline text-[clamp(0.95rem,0.8rem+0.5vw,1.2rem)] font-bold uppercase tracking-[0.28em] text-brand-yellow">{belief.kicker}</p>
      <h2 class="reveal mt-7 max-w-5xl font-headline text-[clamp(1.7rem,0.5rem+6vw,5.5rem)] font-extrabold leading-[1.1] tracking-[-0.01em]" style="--reveal-delay:80ms">{belief.headline}</h2>

      <ol class="relative mt-16 grid gap-y-12 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-6">
        <div class="absolute left-0 right-0 top-11 hidden h-px bg-gradient-to-r from-brand-yellow/30 via-brand-yellow/70 to-brand-yellow/30 lg:block"></div>
        {belief.beats.map((b, i) => (
          <li class="reveal relative flex flex-col items-center text-center sm:items-start sm:text-left" style={`--reveal-delay:${i * 120}ms`}>
            <span class="relative z-10 flex h-[88px] w-[88px] shrink-0 items-center justify-center rounded-full bg-brand-yellow ring-8 ring-ink">
              <img src={b.icon} alt="" width="48" height="48" class="anim-icon h-12 w-12" style={`--anim-delay:${i * 0.3}s`} />
            </span>
            <p class="mt-6 font-headline text-xl font-extrabold uppercase tracking-wide text-brand-yellow">{b.label}</p>
            <p class="mt-2 text-lead text-white/75">{b.text}</p>
            {i < belief.beats.length - 1 && <span aria-hidden="true" class="mt-8 h-10 w-px bg-brand-yellow/50 sm:hidden"></span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. WHAT WE DO -->
  <section id="what-we-do" class="snap relative flex min-h-screen items-center overflow-hidden px-6 py-28 sm:px-12 lg:px-20">
    <VideoBg src={V.stripes} scrim={8} />
    <div class="reveal relative z-10 mx-auto w-full max-w-6xl bg-white p-6 text-ink shadow-2xl sm:p-14">
      <div class="flex items-center gap-3"><span class="font-headline text-eyebrow font-bold uppercase text-ink/55">What we do</span></div>
      <h2 class="mt-4 font-headline text-h2 font-extrabold max-sm:text-[clamp(1.5rem,1rem+2.2vw,2.1rem)]">Five pillars of transformation.</h2>
      <p class="mt-4 max-w-3xl text-lead text-ink/70">Together, these pillars help organizations move from ideas to clarity, from clarity to systems, and from systems to meaningful growth.</p>
      <div class="mt-10 border-t border-ink/15">
        {pillars.map((p, i) => (
          <a href={`#pillar-${p.num}`} class="group flex items-center gap-4 border-b border-ink/15 py-5 sm:gap-6 sm:py-6">
            <span class="w-12 shrink-0 font-headline text-4xl font-extrabold leading-none text-ink/20 transition-colors group-hover:text-brand-yellow sm:w-16 sm:text-5xl">{p.num}</span>
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-brand-yellow transition-transform group-hover:scale-110"><img src={p.icon} alt="" width="22" height="22" class="h-[22px] w-[22px]" style={`--anim-delay:${i * 0.25}s`} /></span>
            <span class="flex-1 font-headline text-xl font-bold leading-tight sm:text-2xl">{p.title}</span>
            <span class="hidden text-sm text-ink/40 md:block">{p.products.length} services</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="hidden h-5 w-5 shrink-0 text-ink/70 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-ink sm:block" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 5-9. PILLAR DETAIL -->
  {pillars.map((p, i) => (
    <section id={`pillar-${p.num}`} class:list={["snap flex min-h-screen items-center px-6 py-24 sm:px-12 lg:px-20 text-ink", i % 2 === 0 ? "bg-white" : "bg-[#f5f5f5]"]}>
      <div class="mx-auto grid w-full max-w-6xl gap-10 lg:grid-cols-[0.7fr_1.6fr] lg:gap-14">
        <div class="reveal group lg:sticky lg:top-24 lg:self-start">
          <div class="flex items-center gap-4">
            <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-brand-yellow sm:h-20 sm:w-20">
              <img src={p.icon} alt="" width="40" height="40" class="h-8 w-8 sm:h-10 sm:w-10" />
            </span>
            <span class="font-headline text-6xl font-extrabold leading-none text-ink/20 transition-colors group-hover:text-brand-yellow sm:text-7xl">{p.num}</span>
          </div>
          <h2 class="mt-6 font-headline text-[clamp(1.9rem,1.2rem+2vw,3.25rem)] font-extrabold leading-[1.1]">{p.title}</h2>
          <p class="mt-5 text-lead text-ink/70">{p.intro}</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
          {p.products.map((pr, j) => (
            <div class="reveal flex flex-col border border-ink/15 bg-white p-7 text-ink transition-colors hover:border-brand-yellow" style={`--reveal-delay:${j * 80}ms`}>
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-brand-yellow">
                <img src={productIcons[i][j]} alt="" width="22" height="22" class="h-[22px] w-[22px]" />
              </span>
              <h3 class="mt-4 font-headline text-lg font-bold leading-snug">{pr.name}</h3>
              <ul class="mt-4 space-y-2.5 text-[15px] text-ink/75">
                {pr.bullets.map((b) => (
                  <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-brand-yellow"></span><span>{b}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- 10. HOW WE WORK — visual timeline -->
  <section id="process" class="snap relative flex min-h-screen items-center overflow-hidden px-6 py-24 text-white sm:px-12 lg:px-20">
    <VideoBg src={V.organic} scrim={50} bg="bg-ink" />
    <div class="relative z-10 mx-auto w-full max-w-3xl">
      <p class="reveal font-headline text-eyebrow font-bold uppercase text-brand-yellow">{process.kicker}</p>
      <h2 class="reveal mt-6 font-headline text-h2 font-extrabold" style="--reveal-delay:80ms">We begin with <span class="text-brand-yellow">clarity.</span></h2>
      <ol class="relative mt-14">
        <div class="absolute bottom-10 left-7 top-7 w-px bg-white/15"></div>
        {process.steps.map((s, i) => (
          <li class="reveal group relative flex gap-6 pb-10 last:pb-0" style={`--reveal-delay:${i * 110}ms`}>
            <span class="relative z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-2 border-brand-yellow/40 bg-ink font-headline text-lg font-extrabold text-white/50 transition-colors group-hover:border-brand-yellow group-hover:text-brand-yellow">{`0${s.n}`}</span>
            <div class="pt-1.5">
              <div class="flex items-center gap-3">
                <span class="block h-7 w-7 shrink-0 bg-brand-yellow" style={`-webkit-mask:url('${s.icon}') center/contain no-repeat;mask:url('${s.icon}') center/contain no-repeat;`}></span>
                <h3 class="font-headline text-2xl font-bold text-brand-yellow">{s.title}</h3>
              </div>
              <p class="mt-2 text-lead text-white/70">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- WHO'S BEHIND IT — Razi + his track record + brands worked with -->
  <section id="team" class="snap relative flex min-h-screen items-center overflow-hidden bg-white px-6 py-24 text-ink sm:px-12 lg:px-20">
    <div class="halftone-anim pointer-events-none absolute inset-0 opacity-[0.07]" style="background:url('/textures/halftone-black.png') center / cover no-repeat;"></div>
    <div class="relative z-10 mx-auto w-full max-w-6xl">
      <p class="reveal font-headline text-eyebrow font-bold uppercase text-ink/55">{team.kicker}</p>
      {team.members.map((m) => (
        <div class="reveal mt-8 grid gap-8 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-12" style="--reveal-delay:80ms">
          <img src={m.photo} alt={m.name} width="240" height="320" class="w-40 object-cover sm:w-52" />
          <div>
            <h2 class="font-headline text-[clamp(2rem,1.2rem+2.5vw,3.5rem)] font-extrabold leading-[1]">{m.name}</h2>
            <p class="mt-2 font-headline text-sm font-bold uppercase tracking-wide text-ink/55">{m.role}</p>
            <p class="mt-4 max-w-xl text-lead text-ink/75">{m.bio}</p>
          </div>
        </div>
      ))}

      <div class="reveal mt-12 border-t border-ink/15 pt-9" style="--reveal-delay:160ms">
        <p class="font-headline text-eyebrow font-bold uppercase text-ink/45">{clients.kicker}</p>
        <div class="marquee mt-5">
          <div class="marquee__track">
            {[...clients.logos, ...clients.logos].map((c, i) => (
              <img src={c.src} alt={i < clients.logos.length ? c.name : ""} aria-hidden={i >= clients.logos.length} loading="lazy" class="h-8 w-auto shrink-0 object-contain opacity-60 grayscale transition duration-300 hover:opacity-100 hover:grayscale-0 sm:h-10" />
            ))}
          </div>
        </div>
      </div>

      <div class="reveal mt-10" style="--reveal-delay:220ms">
        <p class="font-headline text-eyebrow font-bold uppercase text-ink/45">{stats.kicker}</p>
        <div class="mt-6 grid grid-cols-2 gap-x-8 gap-y-8 lg:grid-cols-3">
          {stats.items.map((s) => (
            <div>
              <p class="font-headline text-5xl font-extrabold leading-none text-ink sm:text-6xl">{s.value}</p>
              <p class="mt-2 font-headline text-sm font-semibold uppercase tracking-wide text-ink/55">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 11. WHAT MAKES US DIFFERENT -->
  <section id="different" class="snap relative flex min-h-screen items-center overflow-hidden px-6 py-28 text-white sm:px-12 lg:px-20">
    <VideoBg src={V.sphere} scrim={0} position="object-[85%_25%]" bg="bg-ink" />
    <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(ellipse 62% 72% at 78% 20%, rgba(0,0,0,0) 0%, rgba(0,0,0,0.5) 24%, rgba(0,0,0,0.92) 62%)"></div>
    <div class="relative z-10 mx-auto w-full max-w-6xl [text-shadow:0_2px_14px_rgba(0,0,0,0.85)]">
      <div class="reveal">
        <p class="font-headline text-eyebrow font-bold uppercase text-brand-yellow">{differentiators.kicker}</p>
        <h2 class="mt-6 max-w-4xl font-headline text-[clamp(1.8rem,1.1rem+2.2vw,3.4rem)] font-extrabold leading-[1.1] tracking-[-0.01em]">We don't start from “what should we make?”<br class="hidden sm:block" /> We start from “what needs to change?”</h2>
      </div>
      <div class="mt-12 border-t border-white/15">
        {differentiators.items.map((d, i) => (
          <div class="reveal group flex flex-col gap-2 border-b border-white/15 py-6 sm:flex-row sm:items-baseline sm:gap-8" style={`--reveal-delay:${i * 90}ms`}>
            <span class="w-12 shrink-0 font-headline text-4xl font-extrabold leading-none text-white/25 transition-colors group-hover:text-brand-yellow sm:w-20 sm:text-5xl">0{i + 1}</span>
            <div class="flex-1">
              <h3 class="font-headline text-xl font-bold sm:text-2xl">{d.title}</h3>
              <p class="mt-1.5 text-lead text-white/75">{d.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 12. WHO WE WORK WITH -->
  <section id="audience" class="snap relative flex min-h-screen items-center overflow-hidden px-6 py-28 text-ink sm:px-12 lg:px-20">
    <img src="/images/WOMD_yellow-slide-bg.jpg" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
    <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(ellipse 70% 70% at 50% 50%, rgba(253,216,45,0) 0%, rgba(253,216,45,0.1) 35%, rgba(253,216,45,0.5) 70%, rgba(253,216,45,0.95) 100%)"></div>
    <div class="relative z-10 mx-auto w-full max-w-6xl">
      <div class="reveal">
        <div class="flex items-center gap-3"><span class="font-headline text-eyebrow font-bold uppercase text-ink/60">{audience.kicker}</span></div>
        <h2 class="mt-6 max-w-4xl font-headline text-h2 font-extrabold">{audience.headline}</h2>
      </div>
      <ul class="mt-14 grid gap-x-10 sm:grid-cols-2">
        {audience.items.map((a, i) => (
          <li class="reveal flex items-start gap-4 border-b border-ink/20 py-5 font-headline text-xl font-bold sm:text-2xl" style={`--reveal-delay:${(i % 2) * 90}ms`}>
            <span class="text-ink/40">→</span><span>{a}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 13a. PRE-CLOSING -->
  <section id="future" class="snap relative flex min-h-screen items-center justify-center overflow-hidden px-6 py-28 text-center text-white">
    <VideoBg src={V.tunnel} scrim={55} vignette bg="bg-ink" />
    <div class="pointer-events-none absolute inset-0 bg-black/65"></div>
    <div class="reveal relative z-10 mx-auto max-w-5xl">
      <p class="font-headline text-eyebrow font-bold uppercase text-brand-yellow">The future</p>
      <h2 class="mt-6 font-headline text-h2 font-extrabold leading-[1.1]">{closing.statementLead} <span class="text-brand-yellow">{closing.statementAccent}</span></h2>
      <p class="mx-auto mt-10 max-w-3xl text-xl leading-relaxed text-white/80 sm:text-2xl">{closing.statementBody}</p>
      <a href="#contact" class="mt-14 inline-block bg-brand-yellow px-12 py-5 font-headline text-base font-bold uppercase tracking-[0.2em] text-ink transition hover:brightness-95">{closing.kicker}</a>
    </div>
  </section>

  <!-- 13b. CONTACT -->
  <section id="contact" class="snap relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6 py-28 text-center text-white">
    <VideoBg src={V.neonglow} scrim={0} rate={0.8} bg="bg-ink" />
    <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(ellipse 88% 78% at 50% 50%, rgba(20,20,20,0.9) 0%, rgba(20,20,20,0.74) 58%, rgba(20,20,20,0.5) 100%)"></div>
    <div class="reveal relative z-10 flex w-full max-w-4xl flex-col items-center [text-shadow:0_2px_14px_rgba(0,0,0,0.6)]">
      <p class="font-headline text-eyebrow font-bold uppercase text-brand-yellow">{closing.kicker}</p>
      <h2 class="mt-6 font-headline text-h2 font-extrabold leading-[1.1]">Make your ideas become public conversations <span class="text-brand-yellow">impossible to ignore.</span></h2>

      <div class="mt-14 flex flex-col items-center gap-5 text-lg text-white/90 sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-10 sm:gap-y-4">
        <a href={`mailto:${closing.contact.email}`} class="inline-flex items-center gap-2 transition hover:text-brand-yellow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6 text-brand-yellow"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>{closing.contact.email}
        </a>
        <a href={`tel:${closing.contact.phone.replace(/\s/g, "")}`} class="inline-flex items-center gap-2 transition hover:text-brand-yellow">
