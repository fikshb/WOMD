---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Nav from "../components/Nav.astro";
import { pillars, closing } from "../data/content";

// Per-product icons — order matches pillars[].products (nuclear outline set)
const productIcons = [
  ["/icons/prod-playbook.svg", "/icons/prod-social.svg", "/icons/prod-leadership.svg"],
  ["/icons/prod-brand.svg", "/icons/prod-visual.svg"],
  ["/icons/prod-research.svg", "/icons/prod-pmf.svg", "/icons/prod-dashboard.svg"],
  ["/icons/prod-lms.svg", "/icons/prod-ai.svg", "/icons/prod-website.svg"],
  ["/icons/prod-org.svg", "/icons/prod-training.svg", "/icons/prod-hiring.svg"],
];
---

<Base title="What we do — WOMD" description="Five pillars of transformation: how WOMD helps organizations move from ideas to clarity, from clarity to systems, and from systems to meaningful growth.">
  <Header />
  <Nav />

  <!-- HERO -->
  <section id="hero" class="snap relative flex h-screen flex-col items-center justify-center overflow-hidden bg-ink px-6 py-20 text-center text-white">
    <video
      class="absolute inset-0 h-full w-full object-cover"
      src="/video/WOMD_bg_whatwedo_pingpong_720.mp4"
      poster="/video/WOMD_whatwedo_poster.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    ></video>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0" style="background: radial-gradient(ellipse 95% 85% at 50% 50%, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.8) 45%, rgba(0,0,0,0.5) 75%, rgba(15,15,20,0.15) 100%)"></div>
    <div class="reveal relative z-10 mx-auto flex max-w-4xl flex-col items-center [text-shadow:0_2px_18px_rgba(0,0,0,0.9),0_0_8px_rgba(0,0,0,0.7)]">
      <p class="font-headline text-eyebrow font-bold uppercase tracking-[0.28em] text-brand-yellow">What we do</p>
      <h1 class="mt-6 font-headline text-[clamp(2.2rem,1rem+5vw,5.5rem)] font-extrabold leading-[1.05] tracking-[-0.01em]">
        Five pillars of <span class="text-brand-yellow">transformation.</span>
      </h1>
      <p class="mt-8 max-w-3xl text-lead text-white/90">
        Together, these pillars help organizations move from ideas to clarity,
        from clarity to systems, and from systems to meaningful growth.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-2">
        {pillars.map((p) => (
          <a href={`#pillar-${p.num}`} class="inline-flex items-center gap-2 rounded-full border border-white/25 px-4 py-2 font-headline text-[0.65rem] font-bold uppercase tracking-[0.15em] text-white/85 transition hover:border-brand-yellow hover:bg-brand-yellow hover:text-ink sm:text-xs">
            <span class="text-brand-yellow">{p.num}</span>
            <span>{p.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 5 PILLAR DETAILS -->
  {pillars.map((p, i) => (
    <section id={`pillar-${p.num}`} class:list={["snap relative flex min-h-screen items-center overflow-hidden px-6 py-24 sm:px-12 lg:px-20 text-ink", i % 2 === 0 ? "bg-white" : "bg-[#f5f5f5]"]}>
      <img src={i % 2 === 0 ? "/images/whitebg.jpg" : "/images/greybg.jpg"} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
      <div class="relative z-10 mx-auto grid w-full max-w-6xl gap-10 lg:grid-cols-[0.7fr_1.6fr] lg:gap-14">
        <div class="reveal group lg:sticky lg:top-24 lg:self-start">
          <div class="flex items-center gap-4">
            <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-brand-yellow sm:h-20 sm:w-20">
              <img src={p.icon} alt="" width="40" height="40" class="h-8 w-8 sm:h-10 sm:w-10" />
            </span>
            <span class="font-headline text-6xl font-extrabold leading-none text-ink/20 transition-colors group-hover:text-brand-yellow sm:text-7xl">{p.num}</span>
          </div>
          <h2 class="mt-6 font-headline text-[clamp(1.9rem,1.2rem+2vw,3.25rem)] font-extrabold leading-[1.1]">{p.title}</h2>
          <p class="mt-5 text-lead text-ink/70">{p.intro}</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
          {p.products.map((pr, j) => (
            <div class="reveal flex flex-col border border-ink/15 bg-white p-7 text-ink transition-colors hover:border-brand-yellow" style={`--reveal-delay:${j * 80}ms`}>
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-brand-yellow">
                <img src={productIcons[i][j]} alt="" width="22" height="22" class="h-[22px] w-[22px]" />
              </span>
              <h3 class="mt-4 font-headline text-lg font-bold leading-snug">{pr.name}</h3>
              <ul class="mt-4 space-y-2.5 text-[15px] text-ink/75">
                {pr.bullets.map((b) => (
                  <li class="flex items-start gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-brand-yellow"></span><span>{b}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- CONTACT — same closing slide as home -->
  <section id="contact" class="snap relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6 py-28 text-center text-white">
    <div aria-hidden="true" class="absolute inset-0 bg-ink"></div>
    <img src="/images/nuclear-explosion.jpg" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-ink/80"></div>
    <div class="reveal relative z-10 flex w-full max-w-4xl flex-col items-center [text-shadow:0_2px_14px_rgba(0,0,0,0.6)]">
      <p class="font-headline text-eyebrow font-bold uppercase text-brand-yellow">{closing.kicker}</p>
      <h2 class="mt-6 font-headline text-h2 font-extrabold leading-[1.1]">Make your ideas become public conversations <span class="text-brand-yellow">impossible to ignore.</span></h2>

      <div class="mt-14 flex flex-col items-center gap-5 text-lg text-white/90 sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-10 sm:gap-y-4">
        <a href={`mailto:${closing.contact.email}`} class="inline-flex items-center gap-2 transition hover:text-brand-yellow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6 text-brand-yellow"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>{closing.contact.email}
        </a>
        <a href={`tel:${closing.contact.phone.replace(/\s/g, "")}`} class="inline-flex items-center gap-2 transition hover:text-brand-yellow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6 text-brand-yellow"><path d="M5 4h4l2 5-3 2a14 14 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>{closing.contact.phone}
        </a>
      </div>

      <div class="mt-10 flex items-center gap-4">
        <a href="#" aria-label="Instagram" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/25 text-white transition hover:border-brand-yellow hover:bg-brand-yellow hover:text-ink">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="#" aria-label="LinkedIn" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/25 text-white transition hover:border-brand-yellow hover:bg-brand-yellow hover:text-ink">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.3 0-2.95-1.8-2.95s-2.07 1.4-2.07 2.85V21h-4z"/></svg>
        </a>
        <a href="#" aria-label="WhatsApp" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/25 text-white transition hover:border-brand-yellow hover:bg-brand-yellow hover:text-ink">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.3A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1 1 12 20zm4.4-5.6c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.5 6.5 0 0 1-1.9-1.2 7.2 7.2 0 0 1-1.3-1.7c-.1-.2 0-.4.1-.5l.4-.4.2-.4v-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3A2.8 2.8 0 0 0 6 9.3a4.9 4.9 0 0 0 1 2.6 11.2 11.2 0 0 0 4.3 3.8c.6.3 1.1.4 1.5.5a3.6 3.6 0 0 0 1.6.1c.5-.1 1.4-.6 1.6-1.1s.2-1 .1-1.1z"/></svg>
        </a>
        <a href="#" aria-label="X" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/25 text-white transition hover:border-brand-yellow hover:bg-brand-yellow hover:text-ink">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-[18px] w-[18px]"><path d="M18.9 2H22l-7.6 8.7L23 22h-6.8l-5.3-7-6.1 7H1.7l8.1-9.3L1 2h7l4.8 6.4zm-2.4 18h1.9L7.6 4H5.6z"/></svg>
        </a>
      </div>

      <img src="/logo/WOMD_Icon_SpeechBubble_transparent_1500.png" alt="WOMD" width="44" height="44" class="mt-12 h-10 w-10 opacity-80" />
    </div>
  </section>
</Base>
